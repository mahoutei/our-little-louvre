# Copy this file to .env.local and fill in the values from the Supabase dashboard.
# Never commit .env.local.

# Pooled connection used by the API at runtime.
DATABASE_URL="postgresql://postgres.[project-ref]:[database-password]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# Direct connection used by Prisma migrations and the seed script.
DIRECT_URL="postgresql://postgres.[project-ref]:[database-password]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require"

SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."

# Vite exposes VITE_* values to the browser. Both values are safe to publish.
VITE_SUPABASE_URL="https://[project-ref].supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# The guest list. Only these addresses can open the museum or studio.
OWNER_EMAIL=""
OWNER_NAME=""
PARTNER_EMAIL=""
PARTNER_NAME=""

# Set to 1 to keep the partner's session but hide the collection behind a cover page.
# The owner keeps full access. Restart the API after changing this.
PARTNER_PAUSED=""
PARTNER_PAUSED_MESSAGE="Dean is cooking something"

MUSEUM_NAME="Our Little Louvre"
# Photographs per New Wing alley. A new alley opens when the last one fills.
WING_ALLEY_CAPACITY="6"
# A safety limit on how far the procedural wing can grow.
WING_MAX_ALLEYS="24"
