{
  "name": "our-little-louvre",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,yellow \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "build:e2e": "node scripts/build-e2e.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "npm run build:e2e && playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "db:seed": "dotenv -e .env.local -- node prisma/seed.mjs",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "setup:supabase": "dotenv -e .env.local -- node scripts/setup-supabase.mjs",
    "postinstall": "prisma generate",
    "assets:optimize": "node scripts/optimize-models.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.0",
    "@fontsource/instrument-serif": "^5.2.0",
    "@gsap/react": "^2.1.2",
    "@hono/node-server": "^2.1.9",
    "@hono/vercel": "^1.0.1",
    "@prisma/client": "^6.19.3",
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.4.0",
    "@supabase/supabase-js": "^2.119.0",
    "dotenv": "^17.2.3",
    "gsap": "^3.15.1",
    "hono": "^4.13.19",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.2.0",
    "@gltf-transform/extensions": "^4.2.0",
    "@gltf-transform/functions": "^4.2.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^8.0.0",
    "meshoptimizer": "^0.25.0",
    "prisma": "^6.19.3",
    "sharp": "^0.35.5",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
